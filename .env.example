# Configuração de Identidade da Barbearia (White-label)
NEXT_PUBLIC_APP_NAME="BarberFlow"
NEXT_PUBLIC_SHOP_WHATSAPP="5511999999999"

# Credenciais do Administrador / Dono
ADMIN_EMAIL=admin@barberflow.com
ADMIN_PASSWORD=admin123

# URL e Chaves públicas do Supabase (Opcional no modo demonstração local)
NEXT_PUBLIC_SUPABASE_URL=https://sua-url-supabase.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-aqui

# Chave secreta de serviço do Supabase (para operações de backend/admin)
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-aqui
